{
  "name": "clipboard",
  "description": "剪贴板管理 - 跨平台通用",
  "language": "python",
  "tags": ["clipboard", "copy", "paste", "utility", "builtin", "cross-platform"],
  "input_schema": {
    "type": "object",
    "properties": {
      "action": {"type": "string", "enum": ["read", "write", "clear"], "description": "动作"},
      "text": {"type": "string", "description": "文本内容(写操作时)"}
    },
    "required": ["action"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "success": {"type": "boolean"},
      "text": {"type": "string"}
    }
  },
  "created_by": "system"
}